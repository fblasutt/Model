********************************************************************************
*
*	  Analysis of model simulated reform
*
********************************************************************************

	if  "`c(username)'" == "sara" {
		global JPSC 		"~/Dropbox/Family Risk Sharing/Model_replicated_reform"
	}
	else if "`c(username)'" == "32489" {
		global JPSC 		"~/Dropbox/Family Risk Sharing/Model_replicated_reform"
	}
	
	* Requires ftools, require, reghdfe
	
*------------------------------------------------------------------------------*

*------------------------------------------------------------------------------*
*	    Import data, sample selection and variables creation 
*------------------------------------------------------------------------------*

*import data
clear all 
use "${JPSC}/simulated_did.dta" , clear


*Sample selection
keep if power>=0 & age>=agei  & agei-20<=age_policy-1

*Treatment per event
gen event_time_PER_treat=event_time*treat_group 

*Modify variables to avoid fixed effects with negative value
gen event_time_PER_treat100=event_time_PER_treat+100
gen event_time100=event_time+100



*------------------------------------------------------------------------------*
*							Empirical Analysis
*------------------------------------------------------------------------------*

*Did regression
areg wife_ratio b99.event_time_PER_treat100 if event_time100>95, absorb(event_time100 age idd)
